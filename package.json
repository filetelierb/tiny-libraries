{
  "name": "tailored-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && tsx scripts/pdf-assets.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "types": "wrangler types worker-env.d.ts --include-runtime false",
    "start": "npm run build && npm run dev",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@muse-code/sdk": "^1.4.14",
    "@napi-rs/canvas": "1.0.13",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "katex": "0.19.1",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "mdast-util-from-markdown": "2.0.2",
    "micromark-util-types": "2.0.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
