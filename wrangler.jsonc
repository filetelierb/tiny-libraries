{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tailored-library",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "LIBRARY", "class_name": "Library" },
      { "name": "JOBS", "class_name": "ProcessingJob" },
      { "name": "TUTOR", "class_name": "TutorConversation" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Library", "ProcessingJob"] },
    { "tag": "v2", "new_sqlite_classes": ["TutorConversation"] },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tailored-library-files" }],
  "vars": {
    "APP_URL": "http://127.0.0.1:9876",
    "MEDIA_BRIDGE_URL": "http://127.0.0.1:9877",
    "MEDIA_BRIDGE_TOKEN": "launcher-required",
  },
}
